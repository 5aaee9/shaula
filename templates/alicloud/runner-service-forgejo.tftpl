[Unit]
Description=Shaula ephemeral Forgejo Actions Runner
Wants=network-online.target
After=network-online.target cloud-final.service
ConditionPathExists=!/var/lib/shaula/started

[Service]
Type=simple
User=root
Group=root
UMask=0077
ExecStart=/usr/local/libexec/shaula-runner
Restart=no
KillMode=control-group
NoNewPrivileges=true
TimeoutStopSec=120
