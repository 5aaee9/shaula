{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Shaula Kubernetes Profile Fleet inputs",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "runner_image": {
      "type": "string",
      "enum": ["auto", "ghcr.io/actions/actions-runner:2.337.0", "code.forgejo.org/forgejo/runner:13.1.0"],
      "description": "auto (default) selects the official pinned image for the publisher's runner_backend. An explicit alias must match that backend."
    },
    "cpu_request": {
      "type": "string",
      "enum": ["500m", "1", "2"]
    },
    "memory_request": {
      "type": "string",
      "enum": ["2Gi", "4Gi", "8Gi"]
    }
  }
}
