#!/usr/bin/python3 -I
"""Consume the fixed JIT upload, then replace this process with Runner.Listener."""

import base64
import json
import os
from pathlib import Path
import stat
import sys


JIT_PATH = Path("/shaula/jit_config")
RUNNER_ROOT = Path("/home/runner")
LISTENER = "/home/runner/bin/Runner.Listener"
MAX_JIT_BYTES = 65536
CONFIG_FILES = frozenset({".runner", ".credentials", ".credentials_rsaparams"})


def unique_object(pairs):
    result = {}
    for key, value in pairs:
        if key in result:
            raise ValueError("duplicate JIT member")
        result[key] = value
    return result


def decode_base64(value):
    decoded = base64.b64decode(value, validate=True)
    if not decoded or base64.b64encode(decoded) != value:
        raise ValueError("noncanonical or empty JIT encoding")
    return decoded


def validate_jit(raw):
    # The pinned Runner consumes a base64-encoded JSON dictionary whose
    # values are base64-encoded configuration files. Reject path additions
    # before Runner writes those dictionary keys under its installation.
    if not raw or len(raw) > MAX_JIT_BYTES:
        raise ValueError("JIT size rejected")
    envelope = json.loads(
        decode_base64(raw).decode("utf-8"), object_pairs_hook=unique_object
    )
    if not isinstance(envelope, dict) or set(envelope) != CONFIG_FILES:
        raise ValueError("JIT configuration files rejected")
    for value in envelope.values():
        if not isinstance(value, str):
            raise ValueError("JIT configuration value rejected")
        content = decode_base64(value.encode("ascii"))
        if not isinstance(json.loads(content.decode("utf-8")), dict):
            raise ValueError("JIT configuration object rejected")
    return raw.decode("ascii")


def consume_jit():
    # Linux only: O_NOFOLLOW refuses a symlink; O_NONBLOCK lets the regular
    # file check reject a FIFO without waiting for an external writer.
    flags = os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK | os.O_CLOEXEC
    descriptor = os.open(JIT_PATH, flags)
    with os.fdopen(descriptor, "rb") as staged:
        metadata = os.fstat(staged.fileno())
        if not stat.S_ISREG(metadata.st_mode):
            raise ValueError("JIT upload is not a regular file")
        if metadata.st_size <= 0 or metadata.st_size > MAX_JIT_BYTES:
            raise ValueError("JIT size rejected")
        raw = staged.read(MAX_JIT_BYTES + 1)
    # A failed unlink is fatal too. Never start the Listener with the
    # staged JIT file still present. Invalid consumed uploads are removed.
    JIT_PATH.unlink()
    return validate_jit(raw)


def main():
    try:
        if len(sys.argv) != 1:
            raise ValueError("bootstrap arguments are not supported")
        os.umask(0o077)
        jit = consume_jit()
        environment = {
            key: value
            for key, value in os.environ.items()
            if not key.upper().startswith("ACTIONS_RUNNER_INPUT_")
        }
        environment["ACTIONS_RUNNER_INPUT_JITCONFIG"] = jit
        os.chdir(RUNNER_ROOT)
        # No wrapper or restart loop: signals and exit status belong to
        # the Listener, and argv contains no credential or JIT material.
        os.execve(LISTENER, [LISTENER, "run"], environment)
    except (OSError, ValueError, TypeError, RecursionError):
        # Exception text can contain uploaded data, paths or OS context.
        # Emit one fixed diagnostic and never echo the rejected material.
        sys.stderr.write("bootstrap-shim: JIT bootstrap failed\n")
        return 78


if __name__ == "__main__":
    sys.exit(main())
