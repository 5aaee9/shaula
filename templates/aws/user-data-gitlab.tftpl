#cloud-config
${yamlencode({
  write_files = [
    {
      path        = "/var/lib/shaula/gitlab-config.toml"
      owner       = "root:root"
      permissions = "0600"
      encoding    = "b64"
      content     = base64encode(gitlab_vm.config_toml)
    },
    {
      path        = "/var/lib/shaula/gitlab-runner-name"
      owner       = "root:root"
      permissions = "0600"
      encoding    = "b64"
      content     = base64encode(gitlab.runner_name)
    },
    {
      path        = "/var/lib/shaula/pre-start"
      owner       = "root:root"
      permissions = "0600"
      encoding    = "b64"
      content     = base64encode(pre_start)
    },
    {
      path        = "/usr/local/libexec/shaula-runner"
      owner       = "root:root"
      permissions = "0700"
      encoding    = "b64"
      content     = base64encode(bootstrap)
    },
    {
      path        = "/etc/systemd/system/shaula-runner.service"
      owner       = "root:root"
      permissions = "0644"
      content     = service
    }
  ]
  runcmd = [
    ["systemctl", "daemon-reload"],
    ["systemctl", "start", "--no-block", "shaula-runner.service"]
  ]
})}
